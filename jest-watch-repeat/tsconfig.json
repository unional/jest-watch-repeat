{
	"compilerOptions": {
		"declaration": true,
		"declarationMap": true,
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,
		"isolatedModules": true,
		"lib": ["es2022"],
		"module": "nodenext",
		"moduleResolution": "nodenext",
		"newLine": "LF",
		"noEmit": true,
		"noImplicitAny": false,
		"noUnusedLocals": true,
		"noUnusedParameters": false,
		"skipLibCheck": true,
		"sourceMap": true,
		"strictNullChecks": true,
		"target": "es2022",
		"types": ["node", "vitest/globals"]
	},
	"include": ["ts", "tsdown.config.ts", "vitest.config.ts"]
}
