{
	"name": "jest-watch-repeat",
	"version": "3.0.4",
	"description": "Repeat test suite multiple times",
	"keywords": [
		"jest",
		"jest-watch-plugins",
		"testing",
		"tooling"
	],
	"homepage": "https://github.com/repobuddy/jest-watch-repeat",
	"bugs": {
		"url": "https://github.com/repobuddy/jest-watch-repeat/issues"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/repobuddy/jest-watch-repeat.git"
	},
	"license": "MIT",
	"type": "module",
	"files": [
		"dist",
		"ts",
		"!ts/**/*.spec.ts"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"scripts": {
		"build": "tsdown",
		"build:watch": "tsdown --watch",
		"clean": "rimraf coverage dist .turbo *.tsbuildinfo",
		"coverage": "jest --coverage",
		"depcheck": "depcheck",
		"nuke": "run-s clean && rimraf node_modules",
		"test": "jest",
		"typecheck": "tsc",
		"verify": "npm-run-all clean -p build typecheck coverage depcheck",
		"w": "jest --watch"
	},
	"dependencies": {
		"ansi-escapes": "^4.3.2",
		"chalk": "^4.1.2",
		"jest-watcher": "^30.0.0",
		"unpartial": "^1.0.7"
	},
	"devDependencies": {
		"@repobuddy/jest": "^5.0.0",
		"@types/jest": "^30.0.0",
		"@types/node": "^24.0.0",
		"delay": "^7.0.0",
		"depcheck": "^1.4.3",
		"jest": "^30.0.0",
		"jest-esm-transformer-2": "^1.0.0",
		"jest-watch-suspend": "^1.1.2",
		"jest-watch-toggle-config-2": "^2.1.0",
		"jest-watch-typeahead": "^3.0.0",
		"memory-streams": "^0.1.3",
		"npm-run-all2": "^9.0.0",
		"rimraf": "^6.0.0",
		"ts-jest": "^29.1.0",
		"tsdown": "^0.22.14",
		"typescript": "^5.1.3"
	},
	"peerDependencies": {
		"jest": ">=28"
	},
	"engines": {
		"node": "^20.19.0 || ^22.13.0 || >=24"
	}
}
