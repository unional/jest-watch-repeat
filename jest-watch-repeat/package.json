{
	"name": "jest-watch-repeat",
	"version": "4.0.2",
	"description": "Repeat test suite multiple times",
	"keywords": [
		"jest",
		"jest-watch-plugins",
		"testing",
		"tooling"
	],
	"homepage": "https://github.com/repobuddy/jest-watch-repeat",
	"bugs": {
		"url": "https://github.com/repobuddy/jest-watch-repeat/issues"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/repobuddy/jest-watch-repeat.git"
	},
	"license": "MIT",
	"type": "module",
	"files": [
		"dist",
		"src",
		"!src/**/*.spec.ts"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"scripts": {
		"build": "tsdown",
		"build:watch": "tsdown --watch",
		"clean": "rimraf coverage dist .turbo *.tsbuildinfo",
		"coverage": "vitest run --coverage",
		"depcheck": "depcheck",
		"nuke": "run-s clean && rimraf node_modules",
		"smoke": "node smoke/plugin-loads.mjs && jest --config jest.smoke.config.mjs",
		"test": "vitest run",
		"typecheck": "tsc",
		"verify": "npm-run-all clean -p build typecheck coverage depcheck -s smoke",
		"w": "vitest",
		"watch": "vitest"
	},
	"dependencies": {
		"ansi-escapes": "^4.3.2",
		"chalk": "^6.0.0",
		"jest-watcher": "^30.0.0",
		"unpartial": "^1.0.7"
	},
	"devDependencies": {
		"@repobuddy/vitest": "^2.1.4",
		"@types/node": "^24.0.0",
		"@vitest/coverage-v8": "^4.1.11",
		"delay": "^7.0.0",
		"depcheck": "^1.4.3",
		"jest": "^30.0.0",
		"memory-streams": "^0.1.3",
		"npm-run-all2": "^9.0.0",
		"rimraf": "^6.0.0",
		"tsdown": "^0.23.0",
		"typescript": "^7.0.0",
		"vitest": "^4.1.11"
	},
	"peerDependencies": {
		"jest": ">=28"
	},
	"engines": {
		"node": "^20.19.0 || ^22.13.0 || >=24"
	}
}
